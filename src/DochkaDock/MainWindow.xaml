                Margin="6,0"
                VerticalAlignment="Center"
                Background="#33FFFFFF"/>

        <!-- Fixed, non-reorderable shelf icon: drop files here to hold them
             as temporary references (never copied/moved), click to open the
             shelf popup. Session-only — nothing here persists to
             config.json, cleared on restart. Lives outside the ItemsControl
             entirely, same reasoning as OptionsIconBorder below. -->
