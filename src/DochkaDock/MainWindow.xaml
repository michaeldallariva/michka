<Window x:Class="DochkaDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:DochkaDock.Services"
        mc:Ignorable="d"
        x:Name="RootWindow"
        Title="Dock"
        Height="160"
        SizeToContent="Width"
        MinWidth="80"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        SizeChanged="RootWindow_SizeChanged"
        Loaded="RootWindow_Loaded">
    <Window.Resources>
        <!-- Shared sizing/color for every per-item and Options context-menu
             glyph - black, not the dock's own white (#CCFFFFFF used by the
             dock pill's own icons), because these render against the
             system's light-themed native ContextMenu, not the dark pill. -->
        <Style x:Key="MenuIconBox" TargetType="Viewbox">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
        </Style>
        <Style x:Key="MenuIconPath" TargetType="Path">
            <Setter Property="Fill" Value="#CC000000"/>
        </Style>

        <!-- WaterGlass theme: a translucent "glass tile" sits behind each
             icon's image, built from two layered Borders rather than a real
             backdrop-blur (WPF has no cheap equivalent) - a diagonal
             gradient fill + soft border stroke reads as frosted glass, and a
             separate top-aligned highlight strip fakes the glossy reflection
             a real glass surface would catch. Both are bound straight to
             ThemeService.Instance (not the item's own DataContext) via
             DataTrigger, so every icon - including ones (re)generated later
             by add/remove/reorder - picks up a theme change immediately with
             no per-element invalidation code, the same live-refresh trick
             LocalizationService already uses for {loc:Loc}. -->
        <LinearGradientBrush x:Key="WaterGlassFillBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4DCFE9FF" Offset="0"/>
            <GradientStop Color="#2E6FA8D6" Offset="0.55"/>
            <GradientStop Color="#261E3A52" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WaterGlassHighlightBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#99FFFFFF" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="WaterGlassTileStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="{StaticResource WaterGlassFillBrush}"/>
            <Setter Property="BorderBrush" Value="#59FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static loc:ThemeService.Instance}, Path=IsWaterGlass}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WaterGlassHighlightStyle" TargetType="Border" BasedOn="{StaticResource WaterGlassTileStyle}">
            <Setter Property="CornerRadius" Value="14,14,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource WaterGlassHighlightBrush}"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="1,1,1,0"/>
            <Setter Property="Opacity" Value="0.55"/>
        </Style>

        <!-- DarkGlass: identical tile/highlight construction to WaterGlass
             above, just a near-black fill instead of the blue-tinted one, to
             match the reference screenshot's dark glossy tiles. -->
        <LinearGradientBrush x:Key="DarkGlassFillBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#B3171717" Offset="0"/>
            <GradientStop Color="#A60D0D0D" Offset="0.55"/>
            <GradientStop Color="#99050505" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="DarkGlassTileStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="{StaticResource DarkGlassFillBrush}"/>
            <Setter Property="BorderBrush" Value="#59FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static loc:ThemeService.Instance}, Path=IsDarkGlass}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DarkGlassHighlightStyle" TargetType="Border" BasedOn="{StaticResource DarkGlassTileStyle}">
            <Setter Property="CornerRadius" Value="14,14,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource WaterGlassHighlightBrush}"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="1,1,1,0"/>
            <Setter Property="Opacity" Value="0.55"/>
        </Style>

        <!-- Insets the icon image to sit inside the glass tile with a visible
             rim, same proportions as the reference screenshot - only applied
             under either glass theme (IsAnyGlass); Default keeps the image
             filling the border edge-to-edge exactly as before. This only
             ever changes the Image's own Margin inside the fixed-size
             IconBorder, never IconBorder's Width/Margin, so the Margin/Width
             accumulation GetBaseCenterPositions() relies on for magnify
             geometry is unaffected. -->
        <Style x:Key="ThemedIconImageStyle" TargetType="Image">
            <Setter Property="Margin" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static loc:ThemeService.Instance}, Path=IsAnyGlass}" Value="True">
                    <Setter Property="Margin" Value="7"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <!-- Visual chrome only: rounded "pill" background + shadow. Kept
             separate from the icon layer below because WPF's Border clips
             its child to CornerRadius, which would cut off icons as they
             grow past the pill's edge on hover. -->
        <Border x:Name="DockPill"
                CornerRadius="22"
                Margin="10,10,10,0"
                VerticalAlignment="Bottom"
                Height="68"
                Background="#CC202024"
                BorderBrush="#33FFFFFF"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.45"/>
            </Border.Effect>
        </Border>

        <!-- Icon layer: unclipped, transparent hit-test surface for drag/drop. -->
        <Border Margin="10,10,10,0"
                Padding="12,10"
                VerticalAlignment="Bottom"
                Background="Transparent"
                AllowDrop="True"
                DragOver="DockPill_DragOver"
                Drop="DockPill_Drop">
        <StackPanel Orientation="Horizontal">
        <ItemsControl x:Name="IconsControl" ItemsSource="{Binding}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel x:Name="IconsPanel"
                                Orientation="Horizontal"
                                MouseMove="IconsPanel_MouseMove"
                                MouseLeave="IconsPanel_MouseLeave"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- Wrapping StackPanel so the group-divider can be a true
                         sibling of IconBorder rather than part of its own
                         rendered content: a RenderTransform (hover-magnify)
                         only affects the element it's applied to and that
                         element's own descendants, never siblings, so this is
                         the only way the divider stays a fixed, non-scaling
                         line even while IconBorder grows on hover (an earlier
                         attempt drew it as a BorderThickness stroke ON
                         IconBorder itself, which scaled right along with the
                         icon and poked out above the pill on magnify).
                         GetIconBorders/FindBorder below were updated to find
                         IconBorder specifically (by Tag, which only the real
                         icon Border has), not just "the first Border found",
                         since this divider is a Border too. -->
                    <StackPanel Orientation="Horizontal">
                        <!-- Marks whichever item is currently the first Workspace
                             (see MainWindow.UpdateGroupDividers) — same separator
                             idea as the fixed divider before the gear icon. Its
                             width is a fixed constant (GroupDividerWidth) that
                             GetBaseCenterPositions adds in explicitly for items
                             after it, since this StackPanel wrapper otherwise
                             isn't visible to that margin/width accumulation. -->
                        <Border Width="1" Height="32" Margin="6,0" VerticalAlignment="Center" Background="#33FFFFFF">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowGroupDividerBefore}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Border x:Name="IconBorder"
                            Width="48" Height="48"
                            Margin="8,0"
                            Background="Transparent"
                            RenderTransformOrigin="0.5,1"
                            Tag="{Binding}"
                            ToolTip="{Binding DisplayName}"
                            AllowDrop="True"
                            PreviewMouseLeftButtonDown="Icon_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="Icon_PreviewMouseLeftButtonUp"
                            PreviewMouseMove="Icon_PreviewMouseMove"
                            DragOver="Icon_DragOver"
                            Drop="Icon_Drop">
                        <Border.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                         Opened="ItemContextMenu_Opened">
                                <!-- Open/Open File Location only make sense for a
                                     Shortcut/RecycleBin's single Path; DropAction/Workspace
                                     get their own entries below instead. -->
                                <MenuItem Header="{loc:Loc Key=DockItem_Open}" Click="OpenItem_Click">
                                    <MenuItem.Icon>
                                        <Viewbox Style="{StaticResource MenuIconBox}">
                                            <Path Style="{StaticResource MenuIconPath}" Data="M14,3v2h3.59l-9.83,9.83l1.41,1.41L19,6.41V10h2V3H14z M19,19H5V5h7V3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2,-0.9,2,-2v-7h-2V19z"/>
                                        </Viewbox>
                                    </MenuItem.Icon>
                                    <MenuItem.Style>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="DropAction">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Workspace">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc Key=DockItem_OpenFileLocation}" Click="OpenLocation_Click">
                                    <MenuItem.Icon>
                                        <Viewbox Style="{StaticResource MenuIconBox}">
                                            <Path Style="{StaticResource MenuIconPath}" Data="M10,4H4c-1.1,0,-2,0.9,-2,2v12c0,1.1,0.9,2,2,2h16c1.1,0,2,-0.9,2,-2V8c0,-1.1,-0.9,-2,-2,-2h-8L10,4z"/>
                                        </Viewbox>
                                    </MenuItem.Icon>
                                    <MenuItem.Style>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="DropAction">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Workspace">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc Key=DockItem_EditDropAction}" Click="EditDropAction_Click">
                                    <MenuItem.Icon>
                                        <Viewbox Style="{StaticResource MenuIconBox}">
                                            <Path Style="{StaticResource MenuIconPath}" Data="M3,17.25V21h3.75L17.81,9.94l-3.75,-3.75L3,17.25z M20.71,7.04c0.39,-0.39,0.39,-1.02,0,-1.41l-2.34,-2.34c-0.39,-0.39,-1.02,-0.39,-1.41,0l-1.83,1.83l3.75,3.75L20.71,7.04z"/>
                                        </Viewbox>
                                    </MenuItem.Icon>
                                    <MenuItem.Style>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="DropAction">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc Key=DockItem_LaunchWorkspace}" Click="LaunchWorkspace_Click">
                                    <MenuItem.Icon>
                                        <Viewbox Style="{StaticResource MenuIconBox}">
                                            <Path Style="{StaticResource MenuIconPath}" Data="M4,4h4v4H4V4z M10,4h4v4h-4V4z M16,4h4v4h-4V4z M4,10h4v4H4v-4z M10,10h4v4h-4v-4z M16,10h4v4h-4v-4z M4,16h4v4H4v-4z M10,16h4v4h-4v-4z M16,16h4v4h-4v-4z"/>
                                        </Viewbox>
                                    </MenuItem.Icon>
                                    <MenuItem.Style>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Workspace">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc Key=DockItem_EditWorkspace}" Click="EditWorkspace_Click">
                                    <MenuItem.Icon>
                                        <Viewbox Style="{StaticResource MenuIconBox}">
                                            <Path Style="{StaticResource MenuIconPath}" Data="M3,17.25V21h3.75L17.81,9.94l-3.75,-3.75L3,17.25z M20.71,7.04c0.39,-0.39,0.39,-1.02,0,-1.41l-2.34,-2.34c-0.39,-0.39,-1.02,-0.39,-1.41,0l-1.83,1.83l3.75,3.75L20.71,7.04z"/>
                                        </Viewbox>
                                    </MenuItem.Icon>
                                    <MenuItem.Style>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Workspace">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                </MenuItem>
                                <Separator/>
                                <!-- RAM/Restart/End Task only make sense while running; all
                                     three collapse/disable via RunningWindowCount, which stays
                                     0 for the Recycle Bin (not a process) with no extra check. -->
                                <MenuItem Header="{Binding RunningMemoryMb}" HeaderStringFormat="{loc:Loc Key=DockItem_RamFormat}" IsEnabled="False">
                                    <MenuItem.Style>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RunningWindowCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc Key=DockItem_RestartApp}" Click="RestartApp_Click">
                                    <MenuItem.Icon>
                                        <Viewbox Style="{StaticResource MenuIconBox}">
                                            <Path Style="{StaticResource MenuIconPath}" Data="M12,6v3l4,-4l-4,-4v3c-4.42,0,-8,3.58,-8,8c0,1.57,0.46,3.03,1.24,4.26l1.46,-1.46C6.25,13.97,6,13.01,6,12C6,8.69,8.69,6,12,6z M18.76,7.74l-1.46,1.46C17.75,9.97,18,10.99,18,12c0,3.31,-2.69,6,-6,6v-3l-4,4l4,4v-3c4.42,0,8,-3.58,8,-8C20,10.43,19.54,8.97,18.76,7.74z"/>
                                        </Viewbox>
                                    </MenuItem.Icon>
                                    <MenuItem.Style>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="IsEnabled" Value="True"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RunningWindowCount}" Value="0">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc Key=DockItem_EndTask}" Click="EndTask_Click">
                                    <MenuItem.Icon>
                                        <Viewbox Style="{StaticResource MenuIconBox}">
                                            <Path Style="{StaticResource MenuIconPath}" Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41z"/>
                                        </Viewbox>
                                    </MenuItem.Icon>
                                    <MenuItem.Style>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="IsEnabled" Value="True"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RunningWindowCount}" Value="0">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                </MenuItem>
                                <!-- Only ever applied on a fresh launch, never on a plain
                                     focus-click of an already-running window (see LaunchItem). -->
                                <MenuItem Header="{loc:Loc Key=DockItem_SaveWindowPosition}" Click="SaveWindowPosition_Click">
                                    <MenuItem.Icon>
                                        <Viewbox Style="{StaticResource MenuIconBox}">
                                            <Path Style="{StaticResource MenuIconPath}" Data="M12,2C8.13,2,5,5.13,5,9c0,5.25,7,13,7,13s7,-7.75,7,-13C19,5.13,15.87,2,12,2z M12,11.5c-1.38,0,-2.5,-1.12,-2.5,-2.5s1.12,-2.5,2.5,-2.5s2.5,1.12,2.5,2.5S13.38,11.5,12,11.5z"/>
                                        </Viewbox>
                                    </MenuItem.Icon>
                                    <MenuItem.Style>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="IsEnabled" Value="True"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RunningWindowCount}" Value="0">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc Key=DockItem_ClearSavedPosition}" Click="ClearWindowPosition_Click">
                                    <MenuItem.Icon>
                                        <Viewbox Style="{StaticResource MenuIconBox}">
                                            <Path Style="{StaticResource MenuIconPath}" Data="M6,19c0,1.1,0.9,2,2,2h8c1.1,0,2,-0.9,2,-2V7H6V19z M19,4h-3.5l-1,-1h-5l-1,1H5v2h14V4z"/>
                                        </Viewbox>
                                    </MenuItem.Icon>
                                    <MenuItem.Style>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSavedPlacement}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                </MenuItem>
                                <!-- Items populated imperatively in ItemContextMenu_Opened
                                     (a dynamic, runtime-fetched list - Windows' own per-app
                                     Jump List, only available while the app is running). The
                                     RunningWindowCount gate below is the baseline; the Opened
                                     handler additionally collapses this when the fetch comes
                                     back empty (no Jump List data for this app). -->
                                <MenuItem x:Name="RecentFilesMenuItem" Header="{loc:Loc Key=DockItem_RecentFiles}">
                                    <MenuItem.Icon>
                                        <Viewbox Style="{StaticResource MenuIconBox}">
                                            <Path Style="{StaticResource MenuIconPath}" Data="M13,3c-4.97,0,-9,4.03,-9,9H1l3.89,3.89l0.07,0.14L9,12H6c0,-3.87,3.13,-7,7,-7s7,3.13,7,7s-3.13,7,-7,7c-1.93,0,-3.68,-0.79,-4.94,-2.06l-1.42,1.42C8.27,19.99,10.51,21,13,21c4.97,0,9,-4.03,9,-9S17.97,3,13,3z M12,8v5l4.28,2.54l0.72,-1.21l-3.5,-2.08V8H12z"/>
                                        </Viewbox>
                                    </MenuItem.Icon>
                                    <MenuItem.Style>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RunningWindowCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                </MenuItem>
                                <!-- Visible only for whichever item currently matches the
                                     active system media session (best-effort match, see
                                     MainWindow.MediaSessionMatches) - all collapsed by
                                     default, shown/populated imperatively in
                                     ItemContextMenu_Opened. -->
                                <Separator x:Name="NowPlayingSeparator" Visibility="Collapsed"/>
                                <MenuItem x:Name="NowPlayingHeaderMenuItem" IsEnabled="False" Visibility="Collapsed"/>
                                <MenuItem x:Name="NowPlayingPreviousMenuItem" Header="{loc:Loc Key=DockItem_MediaPrevious}" Visibility="Collapsed" Click="MediaPrevious_Click">
                                    <MenuItem.Icon>
                                        <Viewbox Style="{StaticResource MenuIconBox}">
                                            <Path Style="{StaticResource MenuIconPath}" Data="M6,6h2v12H6V6z M9.5,12l8.5,6V6L9.5,12z"/>
                                        </Viewbox>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="NowPlayingPlayPauseMenuItem" Visibility="Collapsed" Click="MediaPlayPause_Click">
                                    <MenuItem.Icon>
                                        <Viewbox Style="{StaticResource MenuIconBox}">
                                            <Path x:Name="NowPlayingPlayPauseIconPath" Style="{StaticResource MenuIconPath}" Data="M8,5v14l11,-7z"/>
                                        </Viewbox>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="NowPlayingNextMenuItem" Header="{loc:Loc Key=DockItem_MediaNext}" Visibility="Collapsed" Click="MediaNext_Click">
                                    <MenuItem.Icon>
                                        <Viewbox Style="{StaticResource MenuIconBox}">
                                            <Path Style="{StaticResource MenuIconPath}" Data="M6,18l8.5,-6L6,6V18z M16,6v12h2V6H16z"/>
                                        </Viewbox>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="{loc:Loc Key=DockItem_RemoveFromDock}" Click="RemoveItem_Click">
                                    <MenuItem.Icon>
                                        <Viewbox Style="{StaticResource MenuIconBox}">
                                            <Path Style="{StaticResource MenuIconPath}" Data="M6,19c0,1.1,0.9,2,2,2h8c1.1,0,2,-0.9,2,-2V7H6V19z M19,4h-3.5l-1,-1h-5l-1,1H5v2h14V4z"/>
                                        </Viewbox>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid>
                            <Border Style="{StaticResource WaterGlassTileStyle}"/>
                            <Border Style="{StaticResource WaterGlassHighlightStyle}"/>
                            <Border Style="{StaticResource DarkGlassTileStyle}"/>
                            <Border Style="{StaticResource DarkGlassHighlightStyle}"/>
                            <Image Source="{Binding Icon}"
                                   Style="{StaticResource ThemedIconImageStyle}"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <!-- Running indicator: a plain dot for one window,
                                 a small count badge for more than one. This is
                                 an OS-level top-level-window count, not a
                                 browser tab count — those aren't visible
                                 outside the browser process. -->
                            <Border Background="#CCFFFFFF"
                                    CornerRadius="5"
                                    Height="10" MinWidth="10"
                                    Padding="3,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,-4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RunningWindowCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding RunningWindowCount}"
                                           FontSize="8"
                                           FontWeight="Bold"
                                           Foreground="#CC202024"
                                           HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RunningWindowCount}" Value="1">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>
