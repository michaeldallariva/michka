        <!-- Shelf popup: Files (dropped onto ShelfIconBorder) and Clipboard
             (captured by ClipboardMonitorService) sections. Session-only -
             both collections live purely in memory, never persisted. -->
        <Popup x:Name="ShelfPopup"
               PlacementTarget="{Binding ElementName=ShelfIconBorder}"
               Placement="Top"
               VerticalOffset="-8"
               AllowsTransparency="True"
               StaysOpen="False"
               IsOpen="False">
            <Border Background="#F2202024"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12"
                    MinWidth="260" MaxWidth="320"
                    DataContext="{Binding ElementName=RootWindow}">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.4"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=Shelf_FilesHeader}" FontSize="12" FontWeight="SemiBold" Foreground="#FFB0B0B6" Margin="0,0,0,6"/>
                    <TextBlock Text="{loc:Loc Key=Shelf_FilesEmpty}" Foreground="#FF8A8A90" FontSize="11" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShelfFiles.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding ShelfFiles}" MaxHeight="180" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4"
                                      Tag="{Binding}"
                                      MouseMove="ShelfFileRow_MouseMove"
                                      Cursor="Hand">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="#FFEDEDED" FontSize="12"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <Viewbox Grid.Column="2" Width="10" Height="10" Margin="8,0,0,0"
                                             VerticalAlignment="Center" Cursor="Hand"
                                             MouseLeftButtonUp="RemoveShelfFile_Click" Tag="{Binding}">
                                        <Path Data="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12z"
                                              Fill="#FF8A8A90"/>
                                    </Viewbox>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border BorderThickness="0,1,0,0" BorderBrush="#FF323238" Margin="0,0,0,10"/>

                    <TextBlock Text="{loc:Loc Key=Shelf_ClipboardHeader}" FontSize="12" FontWeight="SemiBold" Foreground="#FFB0B0B6" Margin="0,0,0,6"/>
                    <TextBlock Text="{loc:Loc Key=Shelf_ClipboardEmpty}" Foreground="#FF8A8A90" FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ClipboardHistory.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding ClipboardHistory}" MaxHeight="180">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,4" Padding="6" CornerRadius="4" Background="#FF2B2B30"
                                        Tag="{Binding}" Cursor="Hand" MouseLeftButtonUp="ClipboardEntry_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Source="{Binding Image}" Width="24" Height="24" Margin="0,0,8,0"
                                               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <TextBlock Grid.Column="1" Text="{Binding Preview}" Foreground="#FFEDEDED" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
