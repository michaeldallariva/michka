<Window x:Class="DochkaDock.WorkspaceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:loc="clr-namespace:DochkaDock.Services"
        mc:Ignorable="d"
        Title="{loc:Loc Key=Workspace_Title}"
        Width="560" Height="640"
        MinWidth="420" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#FF202024"
        Foreground="#FFEDEDED"
        FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Same visual language as AppPickerWindow/DropActionEditorWindow. -->
        <Style TargetType="Button" x:Key="FooterButtonBase">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Foreground" Value="#FFEDEDED"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="FooterButtonSecondary" BasedOn="{StaticResource FooterButtonBase}">
            <Setter Property="Background" Value="#FF3A3A40"/>
        </Style>
        <Style TargetType="Button" x:Key="FooterButtonPrimary" BasedOn="{StaticResource FooterButtonBase}">
            <Setter Property="Background" Value="#FF505058"/>
        </Style>

        <!-- The default ComboBox template's dropdown Popup ignores the
             control's own Background/Foreground (it pulls from SystemColors
             instead), so without a full retemplate it renders as light text
             on the system's default white popup - unreadable against this
             window's dark theme. -->
        <Style TargetType="ComboBoxItem" x:Key="DarkComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFEDEDED"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF3A3A40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox" x:Key="DarkComboBox">
            <Setter Property="Background" Value="#FF2B2B30"/>
            <Setter Property="Foreground" Value="#FFEDEDED"/>
            <Setter Property="BorderBrush" Value="#FF3C3C42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <Path Data="M0,0 L4,4 L8,0 Z" Fill="#FFB0B0B6"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="#FF2B2B30"
                                        BorderBrush="#FF3C3C42"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="220">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{loc:Loc Key=Workspace_Name}" Margin="0,0,0,4" Foreground="#FFB0B0B6" FontSize="12"/>
            <TextBox x:Name="NameBox"
                     Height="32"
                     Padding="8,5"
                     Background="#FF2B2B30"
                     Foreground="#FFEDEDED"
                     CaretBrush="#FFEDEDED"
                     BorderThickness="1"
                     BorderBrush="#FF3C3C42"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,14"/>

            <TextBlock Text="{loc:Loc Key=Workspace_Icon}" Margin="0,0,0,4" Foreground="#FFB0B0B6" FontSize="12"/>
            <StackPanel Orientation="Horizontal">
                <Border Width="36" Height="36" Margin="0,0,10,0" CornerRadius="8" Background="#FF2B2B30">
                    <Image x:Name="IconPreviewImage" Width="28" Height="28" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <Border x:Name="AutoIconSwatch"
                        Width="32" Height="32" Margin="0,0,6,0" CornerRadius="6"
                        Background="#FF2B2B30" BorderThickness="2" BorderBrush="Transparent"
                        MouseLeftButtonUp="AutoIconSwatch_Click" Cursor="Hand"
                        ToolTip="{loc:Loc Key=Workspace_AutoIconTooltip}">
                    <TextBlock Text="{loc:Loc Key=Workspace_AutoIconLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FFB0B0B6"/>
                </Border>
                <Border x:Name="Preset1Swatch" Width="32" Height="32" Margin="0,0,6,0" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent" Tag="1" MouseLeftButtonUp="PresetSwatch_Click" Cursor="Hand">
                    <Image x:Name="Preset1Image" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <Border x:Name="Preset2Swatch" Width="32" Height="32" Margin="0,0,6,0" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent" Tag="2" MouseLeftButtonUp="PresetSwatch_Click" Cursor="Hand">
                    <Image x:Name="Preset2Image" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <Border x:Name="Preset3Swatch" Width="32" Height="32" Margin="0,0,6,0" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent" Tag="3" MouseLeftButtonUp="PresetSwatch_Click" Cursor="Hand">
                    <Image x:Name="Preset3Image" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <Border x:Name="Preset4Swatch" Width="32" Height="32" Margin="0,0,6,0" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent" Tag="4" MouseLeftButtonUp="PresetSwatch_Click" Cursor="Hand">
                    <Image x:Name="Preset4Image" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <Border x:Name="Preset5Swatch" Width="32" Height="32" Margin="0,0,10,0" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent" Tag="5" MouseLeftButtonUp="PresetSwatch_Click" Cursor="Hand">
                    <Image x:Name="Preset5Image" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <ComboBox x:Name="AppIconCombo"
                          Style="{StaticResource DarkComboBox}"
                          Width="170" Height="32"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="AppIconCombo_SelectionChanged"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <TextBox x:Name="SearchBox"
                     Height="34"
                     Padding="10,6"
                     Background="#FF2B2B30"
                     Foreground="#FFEDEDED"
                     CaretBrush="#FFEDEDED"
                     BorderThickness="1"
                     BorderBrush="#FF3C3C42"
                     VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged"/>
            <TextBlock x:Name="SearchPlaceholder"
                       Text="{loc:Loc Key=Picker_SearchPlaceholder}"
                       Foreground="#FF8A8A90"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>

        <Grid Grid.Row="2">
            <TextBlock x:Name="LoadingText"
                       Text="{loc:Loc Key=Picker_Loading}"
                       Foreground="#FF8A8A90"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="EmptyText"
                       Text="{loc:Loc Key=Picker_NoMatches}"
                       Foreground="#FF8A8A90"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
            <ScrollViewer x:Name="ResultsScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <ItemsControl x:Name="AppsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Tile"
                                    Width="104" Height="92"
                                    Margin="4"
                                    CornerRadius="8"
                                    Background="Transparent"
                                    Tag="{Binding}"
                                    MouseLeftButtonUp="Tile_MouseLeftButtonUp"
                                    ToolTip="{Binding DisplayName}">
                                <StackPanel VerticalAlignment="Center" Margin="4">
                                    <Grid Width="40" Height="40" HorizontalAlignment="Center">
                                        <Image Source="{Binding Icon}" Width="40" Height="40"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Foreground="#FF6FCF6F"
                                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                   Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding DisplayName}"
                                               Margin="0,6,0,0"
                                               FontSize="11"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="30"
                                               Foreground="#FFEDEDED"/>
                                </StackPanel>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FF2E2E34"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="#FF34343C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="#FF323238" Margin="0,16,0,0" Padding="0,14,0,0">
            <DockPanel LastChildFill="False">
                <Button Content="{loc:Loc Key=Workspace_Cancel}" Style="{StaticResource FooterButtonSecondary}"
                        DockPanel.Dock="Left" Click="Cancel_Click"/>
                <Button Content="{loc:Loc Key=Workspace_Save}" Style="{StaticResource FooterButtonPrimary}"
                        DockPanel.Dock="Right" Margin="12,0,0,0" Click="Save_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
