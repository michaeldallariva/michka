<Window x:Class="DochkaDock.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:loc="clr-namespace:DochkaDock.Services"
        mc:Ignorable="d"
        Title="{loc:Loc Key=Picker_Title}"
        Width="560" Height="620"
        MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#FF202024"
        Foreground="#FFEDEDED"
        FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Shared base: plain flat color, no border, content-sized (not
             stretched) — only the background differs between the two. -->
        <Style TargetType="Button" x:Key="FooterButtonBase">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Foreground" Value="#FFEDEDED"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="FooterButtonSecondary" BasedOn="{StaticResource FooterButtonBase}">
            <Setter Property="Background" Value="#FF3A3A40"/>
        </Style>
        <Style TargetType="Button" x:Key="FooterButtonPrimary" BasedOn="{StaticResource FooterButtonBase}">
            <Setter Property="Background" Value="#FF505058"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBox x:Name="SearchBox"
                     Height="34"
                     Padding="10,6"
                     Background="#FF2B2B30"
                     Foreground="#FFEDEDED"
                     CaretBrush="#FFEDEDED"
                     BorderThickness="1"
                     BorderBrush="#FF3C3C42"
                     VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged"/>
            <TextBlock x:Name="SearchPlaceholder"
                       Text="{loc:Loc Key=Picker_SearchPlaceholder}"
                       Foreground="#FF8A8A90"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>

        <Grid Grid.Row="1">
            <TextBlock x:Name="LoadingText"
                       Text="{loc:Loc Key=Picker_Loading}"
                       Foreground="#FF8A8A90"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="EmptyText"
                       Text="{loc:Loc Key=Picker_NoMatches}"
                       Foreground="#FF8A8A90"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
            <ScrollViewer x:Name="ResultsScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <ItemsControl x:Name="AppsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Tile"
                                    Width="104" Height="92"
                                    Margin="4"
                                    CornerRadius="8"
                                    Background="Transparent"
                                    Tag="{Binding}"
                                    MouseLeftButtonUp="Tile_MouseLeftButtonUp"
                                    ToolTip="{Binding DisplayName}">
                                <StackPanel VerticalAlignment="Center" Margin="4">
                                    <Grid Width="40" Height="40" HorizontalAlignment="Center">
                                        <Image Source="{Binding Icon}" Width="40" Height="40"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Foreground="#FF6FCF6F"
                                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                   Visibility="{Binding IsAdded, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding DisplayName}"
                                               Margin="0,6,0,0"
                                               FontSize="11"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="30"
                                               Foreground="#FFEDEDED"/>
                                </StackPanel>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Opacity" Value="1"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FF2E2E34"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                                <Setter Property="Opacity" Value="0.55"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#FF323238" Margin="0,16,0,0" Padding="0,14,0,0">
            <DockPanel LastChildFill="False">
                <Button Content="{loc:Loc Key=Picker_BrowseForFile}" Style="{StaticResource FooterButtonSecondary}"
                        DockPanel.Dock="Left" Click="Browse_Click"/>
                <Button Content="{loc:Loc Key=Picker_Close}" Style="{StaticResource FooterButtonPrimary}"
                        DockPanel.Dock="Right" Margin="12,0,0,0" Click="Close_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
