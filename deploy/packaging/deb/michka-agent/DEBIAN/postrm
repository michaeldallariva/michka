#!/bin/sh
# michka-agent postrm: reload units after removal. On purge, drop the config.
# (No user to clean up — the agent runs under DynamicUser=yes, it never has a static account.)
set -e

if [ -d /run/systemd/system ]; then
  rm -f /etc/systemd/system/michka-agent.service.d/docker.conf 2>/dev/null || true
  rmdir /etc/systemd/system/michka-agent.service.d 2>/dev/null || true
  systemctl daemon-reload >/dev/null 2>&1 || true
fi

if [ "$1" = "purge" ]; then
  rm -f /etc/default/michka-agent
  rm -rf /var/lib/michka-agent-bundle
fi

exit 0
