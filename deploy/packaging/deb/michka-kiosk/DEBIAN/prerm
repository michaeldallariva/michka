#!/bin/sh
# michka-kiosk prerm: stop + disable the kiosk before its files (incl. the hub root drop-in) go away.
set -e

case "$1" in
  remove|deconfigure)
    if [ -d /run/systemd/system ]; then
      systemctl stop michka-kiosk.service >/dev/null 2>&1 || true
      systemctl disable michka-kiosk.service >/dev/null 2>&1 || true
    fi
    ;;
esac

exit 0
