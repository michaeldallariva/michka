#!/bin/sh
# michka-kiosk postrm: the helper units + polkit rule go away with the package; just reload systemd
# + polkit. The hub was never elevated (it runs unprivileged as the static "michka" user), so nothing to revert.
set -e

if [ -d /run/systemd/system ]; then
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl reload polkit.service >/dev/null 2>&1 || true
fi

exit 0
