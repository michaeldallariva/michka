[Unit]
Description=Michka kiosk: power the panel OFF (screensaver sleep)
# A root helper the (possibly unprivileged) hub triggers via `systemctl start` to drive wlr-randr in
# the kiosk's own Wayland session (run by the unprivileged "kiosk" user — see michka-kiosk.service),
# which the hub itself can't reach when it runs as a non-root user. Authorised for the hub's service
# user (member of group michka) by the michka polkit rule. Runs as root itself (no User= set) purely
# so it can read another user's /run/user/<uid> session — it only drives wlr-randr, nothing else.
# No-op (logged) if wlr-randr / the compositor doesn't support output power management.

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'uid=$(id -u kiosk 2>/dev/null || echo 0); sock=$(ls /run/user/$uid/ 2>/dev/null | grep -E "^wayland-[0-9]+$" | head -1); export XDG_RUNTIME_DIR=/run/user/$uid WAYLAND_DISPLAY=$sock; wlr-randr 2>/dev/null | grep -E "^[^[:space:]]" | cut -d " " -f1 | while read o; do wlr-randr --output "$o" --off; done'
