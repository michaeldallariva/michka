[Unit]
Description=Michka kiosk: power the panel ON (wake from screensaver sleep)
# Companion to michka-screen-off.service — see that unit's header. Triggered by the hub via
# `systemctl start` (authorised by the michka polkit rule) to wake the panel.

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'uid=$(id -u kiosk 2>/dev/null || echo 0); sock=$(ls /run/user/$uid/ 2>/dev/null | grep -E "^wayland-[0-9]+$" | head -1); export XDG_RUNTIME_DIR=/run/user/$uid WAYLAND_DISPLAY=$sock; wlr-randr 2>/dev/null | grep -E "^[^[:space:]]" | cut -d " " -f1 | while read o; do wlr-randr --output "$o" --on; done'
