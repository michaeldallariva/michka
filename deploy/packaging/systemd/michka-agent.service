[Unit]
Description=Michka monitor agent (pushes local metrics to a hub)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs unprivileged with no account to create: systemd allocates a transient user for this service
# (named after the unit) at start, never written to /etc/passwd.
DynamicUser=yes
# Settings live in /etc/default/michka-agent (MICHKA_ARGS). At minimum it must set --hub.
EnvironmentFile=-/etc/default/michka-agent
# The self-contained binary unpacks bundled native libs to a cache dir at startup. It MUST be writable
# AND exec, or dlopen() of the unpacked native libs (e_sqlite3) fails with "failed to map segment from
# shared object" and the agent crash-loops. Under DynamicUser the StateDirectory is mounted noexec
# (idmapped), so extraction goes to a plain /var/lib path exposed via ReadWritePaths (stays exec in the
# sandbox); the dir is created 1777 by tmpfiles.d/michka.conf.
StateDirectory=michka-agent
ReadWritePaths=/var/lib/michka-agent-bundle
Environment=DOTNET_BUNDLE_EXTRACT_BASE_DIR=/var/lib/michka-agent-bundle
ExecStart=/opt/michka/michka_c --agent $MICHKA_ARGS
Restart=always
RestartSec=5
# The agent only reads /proc + /sys and pushes over the network — lock everything else down.
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
