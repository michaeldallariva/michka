[Unit]
Description=Michka hardware monitor hub
Documentation=https://github.com/  (see /opt/michka and the Michka README)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The hub runs UNPRIVILEGED, never as root. It runs as a dedicated, locked, no-login system user
# (default "michka", chosen at install time) that the installer creates — NOT a systemd DynamicUser.
# Reason: Debian's default bus is the reference dbus-daemon, which REFUSES connections from DynamicUser
# identities (it resets the connection right after Hello while resolving the transient uid). That would
# silently break every kiosk/display action the hub performs through `systemctl` (screen power,
# exit-to-login, config restart, kiosk-autostart toggle). A static system user connects to the system
# bus normally, so those work. The actions are authorised for the hub by a polkit rule keyed on the
# "michka" GROUP (see /etc/polkit-1/rules.d/49-michka.rules, installed by the michka-kiosk add-on); the
# installer puts the run-user in that group. Screen power is delegated to the root michka-screen-*
# helper units. So the hub stays unprivileged with no feature lost.
#
# A non-default/existing/root run-user selected at install time is applied via a drop-in
# (/etc/systemd/system/michka-hub.service.d/10-run-user.conf) that overrides User=/Group=; the default
# below is used when the standard "michka" user was created.
User=michka
Group=michka
WorkingDirectory=/var/lib/michka
# StateDirectory gives the run-user a writable /var/lib/michka (systemd creates + owns it). Unlike a
# DynamicUser, a static user's StateDirectory is a plain, exec-capable directory, so the self-contained
# binary can self-extract its bundled native libs (e_sqlite3) inside it — no separate noexec workaround
# (the old /var/lib/michka-bundle + tmpfiles + ReadWritePaths dance) is needed.
StateDirectory=michka
Environment=DOTNET_BUNDLE_EXTRACT_BASE_DIR=/var/lib/michka/.bundle
ExecStart=/opt/michka/michka_s --db /var/lib/michka/michka.db
# A port change in the Settings page exits the process; systemd brings it back with the new port.
Restart=always
RestartSec=2
# Hardening.
NoNewPrivileges=true
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
